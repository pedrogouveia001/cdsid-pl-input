      object IWText7: TIWText
        Left = 3
        Top = 29
        Width = 458
        Height = 364
        Cursor = crAuto
        IW50Hint = False
        ParentShowHint = False
        ShowHint = True
        ZIndex = 0
        RenderSize = True
        StyleRenderOptions.RenderSize = True
        StyleRenderOptions.RenderPosition = True
        StyleRenderOptions.RenderFont = True
        StyleRenderOptions.RenderZIndex = True
        StyleRenderOptions.RenderVisibility = True
        StyleRenderOptions.RenderStatus = True
        StyleRenderOptions.RenderAbsolute = True
        BGColor = clNone
        ConvertSpaces = False
        Font.Color = clNone
        Font.FontName = 'verdana'
        Font.Size = 8
        Font.Style = []
        FriendlyName = 'txtregradedecisao'
        Lines.Strings = (
          
            'The Average Loss ('#181'(Aj, Ai)) is calculated by comparing the diff' +
            'erence between a given solution and all other solutions when eac' +
            'h of the other solutions is selected. This metric quantifies the' +
            ' expected performance loss relative to the evaluated solution, p' +
            'roviding a comprehensive assessment of decision impact.'
          ''
          
            'The Average Gain ('#181'(Ai, Aj)) is calculated by comparing the diff' +
            'erence between a given solution and all other solutions when the' +
            ' evaluated solution is selected. This metric quantifies the expe' +
            'cted performance improvement relative to each alternative soluti' +
            'on, providing a comprehensive assessment of decision impact.'
          ''
          
            'The Maximum Loss (Dmax(Aj, Ai)  is determined by identifying the' +
            ' highest difference between a given solution and any of the othe' +
            'r solutions when they are selected. In other words, it represent' +
            's the greatest potential disadvantage of a solution compared to ' +
            'the others, highlighting the worst-case performance gap in the d' +
            'ecision-making process.'
          ''
          'The Global Performance of a Solution is calculated by:'
          'G(Ai)= P(Ai)*'#181'(Ai, Aj)-(1-P(Ai))*'#181'(Aj, Ai)'
          ''
          'Where,'
          'G(Ai) : Global Performance of Solution Ai;'
          'P(Ai) : Probability of Solution Ai;'
          #181'(Ai, Aj) : Average difference between Solution Ai and Aj;'
          #181'(Aj, Ai) : Average difference between Solution Aj and Ai.'
          '')
        RawText = False
        UseFrame = False
        WantReturns = True
      end
