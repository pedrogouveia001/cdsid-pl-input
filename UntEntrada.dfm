          StyleRenderOptions.RenderVisibility = True
          StyleRenderOptions.RenderStatus = True
          StyleRenderOptions.RenderAbsolute = True
          BGColor = clNone
          ConvertSpaces = False
          Font.Color = clNone
          Font.FontName = 'verdana'
          Font.FontFamily = 'Verdana, Helvetica, Sans-Serif'
          Font.Size = 10
          Font.Style = []
          FriendlyName = 'txtCaixaDialogoRU'
          Lines.Strings = (
            
              'By continuing, you will be redirected to the CDSID unified regis' +
              'tration system. '
            ''
            
              'Now, you have a unique registration (e-mail and password) to acc' +
              'ess all the CDSID applications (FITradeoff, Promethee - ROC, SID' +
              'MCPM, etc...).'
            ''
            
              'In order to manage your account information you shall visit <htt' +
              'p://15.229.155.120/CDSID-Access/>. By doing so, your access cred' +
              'entials will be updated in all the apps.'
            ''
            
              'If you have any doubts, please contact us at fitradeoff@cdsid.or' +
              'g.br.')
          RawText = False
          UseFrame = False
          WantReturns = True
        end
