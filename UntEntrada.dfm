    object rgndescricaoPromethee: TIWRegion
      Left = 870
      Top = 242
      Width = 467
      Height = 401
      Cursor = crAuto
      Visible = False
      RenderInvisibleControls = False
      BorderOptions.NumericWidth = 1
      BorderOptions.BorderWidth = cbwNumeric
