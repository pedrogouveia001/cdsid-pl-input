        object txtCaixaDialogoRU2: TIWText
          Left = 15
          Top = 19
          Width = 492
          Height = 226
          Cursor = crAuto
          IW50Hint = False
          ParentShowHint = False
          ShowHint = True
          ZIndex = 0
          RenderSize = True
